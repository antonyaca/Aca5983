//@version=5
// Williams TOP (Nasdaq, intraday) + RSI2 et 3 baisses (Nasdaq et S&P, swing) — repo Aca5983, backtests du 06/11/2026.
// Williams TOP : k = 0,4 × amplitude de la veille autour de l'ouverture 15h30 Paris. UN seul ordre, dans le sens de la SMA200
//   journalière du NDX (achat stop si au-dessus, vente stop si en dessous). Stop = ouverture. Entrée possible jusqu'à 17h30 Paris,
//   sinon annuler. Trailing stop de 1R (= distance entrée-ouverture). Clôture 22h00 Paris si pas sorti avant.
// RSI2 / 3 baisses : contrôle à 21h55 Paris (achat / sortie), taille = risque / ATR14, sans stop (comme le backtest).
// Utilisation : graphique NAS100 en M1. UNE alerte « Tout appel de la fonction alert() ».
indicator("Williams TOP + RSI2 + 3 baisses — US", overlay = true, max_labels_count = 500)

riskEUR  = input.float(100.0, "Risque par trade (€)", minval = 1)
pointEUR = input.float(0.9, "Valeur d'1 point pour 1 lot (€)", minval = 0.0001)
mt5mult  = input.int(100, "Points MT5 par point d'indice (2 décimales = 100)", minval = 1)
k        = input.float(0.4, "Williams : k", minval = 0.05, step = 0.05)
trailR   = input.float(1.0, "Trailing (en R)", minval = 0.1, step = 0.25)
useW     = input.bool(true, "Activer Williams TOP (Nasdaq)")
useRSI   = input.bool(true, "Activer RSI2 (Nasdaq + S&P)")
use3B    = input.bool(true, "Activer 3 baisses (Nasdaq + S&P)")
symN     = input.symbol("NASDAQ:NDX", "Indice Nasdaq (filtre + swing)")
symS     = input.symbol("SP:SPX", "Indice S&P 500 (swing)")

tz      = "America/New_York"
tfMin   = timeframe.isminutes ? timeframe.multiplier : 1
inSess  = not na(time(timeframe.period, "0930-1600", tz))
newSess = inSess and not inSess[1]
m       = hour(time, tz) * 60 + minute(time, tz)
mEnd    = m + tfMin

f_lots(dist) => dist > 0 ? riskEUR / (dist * pointEUR) : na
f_txt(x) => str.tostring(x, format.mintick)
f_lotTxt(dist) => str.tostring(f_lots(dist), "#.##") + " lot"

// ===== données journalières des indices
f_daily() =>
    tr14 = ta.sma(ta.tr(true), 14)
    down3 = close < close[1] and close[1] < close[2] and close[2] < close[3]
    [close, close[1], ta.rsi(close, 2), ta.sma(close, 200), ta.sma(close, 5), tr14, down3, ta.sma(close, 200)[1]]
[cN, pcN, rsiN, s200N, s5N, atrN, d3N, s200Nprev] = request.security(symN, "D", f_daily())
[cS, pcS, rsiS, s200S, s5S, atrS, d3S, s200Sprev] = request.security(symS, "D", f_daily())

// ===== WILLIAMS TOP
var float curH = na
var float curL = na
var float prevRange = na
var float dayOpen = na
var float lvl = na          // niveau d'entrée du jour
var int   dir = 0           // 1 achat, -1 vente (sens SMA200)
var int   st = 0            // 0 attente 15h30, 1 ordre posé, 2 en position, 3 terminé
var float entry = na
var float R = na
var float best = na
var float trail = na
var string fin = ""

if newSess
    if not na(curH)
        prevRange := curH - curL
    curH := high
    curL := low
    dayOpen := open
    fin := ""
    entry := na
    trail := na
    if useW and not na(prevRange) and not na(s200Nprev)
        // ouverture au-dessus de la SMA200 journalière du NDX (calculée jusqu'à la veille) ? → achats seulement, sinon ventes
        dir := dayOpen > s200Nprev ? 1 : -1
        lvl := dayOpen + dir * k * prevRange
        R := k * prevRange
        st := 1
        if barstate.isconfirmed
            alert("NASDAQ — À FAIRE : place une " + (dir == 1 ? "ACHAT STOP" : "VENTE STOP") + " à " + f_txt(lvl) +
                  " | Stop loss " + f_txt(dayOpen) + " | Trailing " + str.tostring(math.round(R * trailR * mt5mult)) +
                  " points MT5 | " + f_lotTxt(R) + ". Annule à 17h30 si pas déclenché.", alert.freq_once_per_bar_close)
    else
        st := 3
        fin := "Pas de trade aujourd'hui"
else if inSess
    curH := math.max(curH, high)
    curL := math.min(curL, low)

trig = false
exitTrail = false
if useW and inSess and not newSess
    if st == 1
        if m >= 660
            st := 3
            fin := "Pas déclenché : ordre annulé"
            if barstate.isconfirmed
                alert("NASDAQ — À FAIRE : 17h30, pas déclenché. SUPPRIME ton ordre. Plus de Williams aujourd'hui.", alert.freq_once_per_bar_close)
        else if (dir == 1 and high >= lvl) or (dir == -1 and low <= lvl)
            st := 2
            entry := dir == 1 ? math.max(lvl, open) : math.min(lvl, open)
            best := entry
            trail := dayOpen
            trig := true
    else if st == 2
        hitStop = dir == 1 ? low <= trail : high >= trail
        if hitStop
            st := 3
            exitTrail := true
            fin := "Sorti par le stop à " + f_txt(trail)
        else
            best := dir == 1 ? math.max(best, high) : math.min(best, low)
            ns = best - dir * trailR * R
            trail := dir == 1 ? math.max(trail, ns) : math.min(trail, ns)

if trig
    alert("NASDAQ — DÉCLENCHÉ : tu es " + (dir == 1 ? "ACHETEUR" : "VENDEUR") + " à " + f_txt(entry) + ". Vérifie que ton trailing stop est actif. Clôture 22h00.", alert.freq_once_per_bar)
if exitTrail
    alert("NASDAQ — SORTI par le trailing stop. Trade terminé pour aujourd'hui.", alert.freq_once_per_bar)
closeSoon = inSess and m < 955 and mEnd >= 955 and st == 2
if useW and closeSoon and barstate.isconfirmed
    alert("NASDAQ — À FAIRE : 21h55, FERME ta position Williams avant 22h00.", alert.freq_once_per_bar_close)
if useW and inSess and m < 960 and mEnd >= 960 and st == 2
    st := 3
    fin := "Clôturé à 22h00"

// ===== SWING (RSI2, 3 baisses)
checkTime = inSess and m < 955 and mEnd >= 955 and barstate.isconfirmed
var bool rsiInN = false
var bool rsiInS = false
var bool b3InN = false
var bool b3InS = false
var int  b3DaysN = 0
var int  b3DaysS = 0
f_name(isN) => isN ? "NASDAQ (NAS100)" : "S&P 500 (US500)"
if checkTime
    if useRSI
        if rsiInN and cN > s5N
            rsiInN := false
            alert("RSI2 " + f_name(true) + " — À FAIRE : VENDS ta position avant 22h00.")
        else if not rsiInN and rsiN < 10 and cN > s200N
            rsiInN := true
            alert("RSI2 " + f_name(true) + " — À FAIRE : ACHÈTE " + f_lotTxt(atrN) + " avant 22h00. Pas de stop. Je te dirai quand sortir.")
        if rsiInS and cS > s5S
            rsiInS := false
            alert("RSI2 " + f_name(false) + " — À FAIRE : VENDS ta position avant 22h00.")
        else if not rsiInS and rsiS < 10 and cS > s200S
            rsiInS := true
            alert("RSI2 " + f_name(false) + " — À FAIRE : ACHÈTE " + f_lotTxt(atrS) + " avant 22h00. Pas de stop. Je te dirai quand sortir.")
    if use3B
        if b3InN
            b3DaysN += 1
            if cN > pcN or b3DaysN >= 5
                b3InN := false
                alert("3 baisses " + f_name(true) + " — À FAIRE : VENDS ta position avant 22h00.")
        else if d3N
            b3InN := true
            b3DaysN := 0
            alert("3 baisses " + f_name(true) + " — À FAIRE : ACHÈTE " + f_lotTxt(atrN) + " avant 22h00. Pas de stop. Je te dirai quand sortir.")
        if b3InS
            b3DaysS += 1
            if cS > pcS or b3DaysS >= 5
                b3InS := false
                alert("3 baisses " + f_name(false) + " — À FAIRE : VENDS ta position avant 22h00.")
        else if d3S
            b3InS := true
            b3DaysS := 0
            alert("3 baisses " + f_name(false) + " — À FAIRE : ACHÈTE " + f_lotTxt(atrS) + " avant 22h00. Pas de stop. Je te dirai quand sortir.")

// ===== AFFICHAGE SUR LE GRAPHIQUE
showLvl = useW and inSess and (st == 1 or st == 2 or (st == 3 and not na(entry)))
plot(showLvl ? lvl : na, "Niveau d'entrée", dir == 1 ? color.green : color.red, 2, plot.style_linebr)
plot(useW and inSess and st >= 1 ? dayOpen : na, "Stop initial (ouverture)", color.gray, 1, plot.style_linebr)
plot(useW and inSess and st == 2 ? trail : na, "Trailing stop", color.orange, 2, plot.style_linebr)
plotshape(trig and dir == 1, "Achat", shape.labelup, location.belowbar, color.green, text = "ACHAT", textcolor = color.white, size = size.small)
plotshape(trig and dir == -1, "Vente", shape.labeldown, location.abovebar, color.red, text = "VENTE", textcolor = color.white, size = size.small)
plotshape(exitTrail, "Sortie trailing", shape.xcross, location.abovebar, color.orange, size = size.small)

// ===== PANNEAU « QUE FAIRE MAINTENANT »
var table tb = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.gray)
f_row(r, a, b, col) =>
    table.cell(tb, 0, r, a, text_color = color.white, text_size = size.normal, text_halign = text.align_left)
    table.cell(tb, 1, r, b, text_color = col, text_size = size.normal, text_halign = text.align_left)
if barstate.islast
    string action = ""
    color  acol = color.white
    if not useW
        action := "Williams désactivé"
    else if not inSess
        action := "Attendre 15h30 Paris"
    else if st == 1
        action := (dir == 1 ? "ACHAT STOP " : "VENTE STOP ") + f_txt(lvl)
        acol := dir == 1 ? color.lime : color.red
    else if st == 2
        action := "EN POSITION — laisse courir"
        acol := color.orange
    else
        action := fin == "" ? "Rien à faire" : fin
    table.cell(tb, 0, 0, "WILLIAMS NASDAQ", text_color = color.yellow, text_size = size.large)
    table.cell(tb, 1, 0, "", text_color = color.white)
    f_row(1, "À faire", action, acol)
    f_row(2, "Sens du jour", dir == 1 ? "ACHAT seulement" : dir == -1 ? "VENTE seulement" : "-", dir == 1 ? color.lime : color.red)
    f_row(3, "Stop loss", f_txt(dayOpen), color.white)
    f_row(4, "Trailing MT5", na(R) ? "-" : str.tostring(math.round(R * trailR * mt5mult)) + " points", color.orange)
    f_row(5, "Taille", na(R) ? "-" : f_lotTxt(R) + " (" + str.tostring(riskEUR) + " €)", color.white)
    f_row(6, "RSI2 en cours", (rsiInN ? "NAS OUI" : "NAS -") + " / " + (rsiInS ? "S&P OUI" : "S&P -"), color.white)
    f_row(7, "3 baisses en cours", (b3InN ? "NAS OUI" : "NAS -") + " / " + (b3InS ? "S&P OUI" : "S&P -"), color.white)
