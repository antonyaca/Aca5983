//@version=5
// Nasdaq — 3 stratégies validées par backtest 2020-2026 (repo Aca5983). Heure de New York, heure d'été gérée.
// 1. Pré-marché : range 04:00-09:30 NY (10:00-15:30 Paris). 1er franchissement entre 09:30 et 15:00 NY = trade
//    (achat ou vente), stop = bord opposé.
// 2. Williams : ouverture 09:30 NY ± 0,5 × amplitude de la séance de la veille. 1er niveau touché = trade, stop = ouverture.
// 3. ORB 30 min (achats seuls) : range 09:30-10:00 NY. Achat stop au plus haut, stop loss au plus bas ;
//    annulé si le bas casse d'abord. Entrées jusqu'à 15:00 NY.
// Toutes : pas de TP, sortie 16:00 NY (22:00 Paris).
// Alertes : UNE alerte sur ce script, condition « Tout appel de la fonction alert() ». Utiliser en M1 (ou M5).
indicator("Nasdaq — Pré-marché + Williams + ORB", overlay = true, max_labels_count = 500)

riskEUR  = input.float(100.0, "Risque par trade (€)", minval = 1)
pointEUR = input.float(1.0, "Valeur d'1 point pour 1 lot (€) — à vérifier chez ton broker", minval = 0.0001)
k        = input.float(0.5, "Williams : k", minval = 0.05, step = 0.05)
useP     = input.bool(true, "Activer Pré-marché")
useW     = input.bool(true, "Activer Williams")
useORB   = input.bool(true, "Activer ORB 30 min (achats seuls)")

tz      = "America/New_York"
tfMin   = timeframe.isminutes ? timeframe.multiplier : 1
inPre   = not na(time(timeframe.period, "0400-0930", tz))
newPre  = inPre and not inPre[1]
inSess  = not na(time(timeframe.period, "0930-1600", tz))
newSess = inSess and not inSess[1]
m       = hour(time, tz) * 60 + minute(time, tz)
mEnd    = m + tfMin

f_lots(dist) => dist > 0 ? riskEUR / (dist * pointEUR) : na
f_txt(x) => str.tostring(x, format.mintick)
f_size(dist) => str.tostring(f_lots(dist), "#.##") + " lot pour " + str.tostring(riskEUR) + " €"

// ---------- pré-marché
var float pmH = na
var float pmL = na
var int   pState = 0          // 0 attente, 1 achat, -1 vente, 9 terminé
if newPre
    pmH := high
    pmL := low
else if inPre
    pmH := math.max(pmH, high)
    pmL := math.min(pmL, low)

// ---------- séance, Williams, ORB
var float curH = na
var float curL = na
var float prevRange = na
var float dayOpen = na
var float wUp = na
var float wDn = na
var int   wDir = 0
var float orbH = na
var float orbL = na
var bool  orbReady = false
var int   orbState = 0

if newSess
    if not na(curH)
        prevRange := curH - curL
    curH := high
    curL := low
    dayOpen := open
    wUp := na(prevRange) ? na : dayOpen + k * prevRange
    wDn := na(prevRange) ? na : dayOpen - k * prevRange
    wDir := 0
    orbH := high
    orbL := low
    orbReady := false
    orbState := 0
    pState := 0
    if barstate.isconfirmed
        if useP and not na(pmH)
            alert("Nasdaq — PRÉ-MARCHÉ : achat stop " + f_txt(pmH) + " / vente stop " + f_txt(pmL) + " (stop = l'autre niveau, " +
                  f_size(pmH - pmL) + "). Annule l'autre ordre au 1er déclenchement.", alert.freq_once_per_bar_close)
        if useW and not na(wUp)
            alert("Nasdaq — WILLIAMS : achat stop " + f_txt(wUp) + " / vente stop " + f_txt(wDn) + " / stop loss " + f_txt(dayOpen) +
                  " (" + f_size(wUp - dayOpen) + "). Annule l'autre ordre au 1er déclenchement.", alert.freq_once_per_bar_close)
else if inSess
    curH := math.max(curH, high)
    curL := math.min(curL, low)
    if m < 600
        orbH := math.max(orbH, high)
        orbL := math.min(orbL, low)

orbJustReady = inSess and not orbReady and m < 600 and mEnd >= 600
if orbJustReady
    orbReady := true
    if useORB and barstate.isconfirmed
        alert("Nasdaq — ORB : achat stop " + f_txt(orbH) + ", stop loss " + f_txt(orbL) + " (" + f_size(orbH - orbL) +
              "). Pas de vente. Annuler si le bas casse d'abord.", alert.freq_once_per_bar_close)

// ---------- déclenchements pré-marché (09:30-15:00 NY)
pBuy = false
pSell = false
if useP and inSess and pState == 0 and not na(pmH) and m < 900
    upHit = high > pmH
    dnHit = low < pmL
    if upHit and dnHit
        pState := 9
    else if upHit
        pState := 1
        pBuy := true
    else if dnHit
        pState := -1
        pSell := true
if useP and inSess and pState == 0 and m >= 900
    pState := 9

// ---------- déclenchements Williams
wBuy = false
wSell = false
if useW and inSess and not newSess and wDir == 0 and not na(wUp)
    upHit = high >= wUp
    dnHit = low <= wDn
    if upHit and dnHit
        wDir := 9
    else if upHit
        wDir := 1
        wBuy := true
    else if dnHit
        wDir := -1
        wSell := true

// ---------- déclenchements ORB (10:00-15:00 NY)
orbBuy = false
orbCancel = false
if useORB and inSess and orbReady and not orbJustReady and orbState == 0 and m < 900
    upHit = high > orbH
    dnHit = low < orbL
    if upHit and dnHit
        orbState := 9
    else if upHit
        orbState := 1
        orbBuy := true
    else if dnHit
        orbState := -1
        orbCancel := true
if useORB and inSess and orbState == 0 and orbReady and m >= 900
    orbState := 9

// ---------- alertes de déclenchement
if pBuy
    alert("Nasdaq — PRÉ-MARCHÉ DÉCLENCHÉ : ACHAT à " + f_txt(pmH) + ", stop " + f_txt(pmL) + ". Supprime la vente stop. Clôture 22h00 Paris.", alert.freq_once_per_bar)
if pSell
    alert("Nasdaq — PRÉ-MARCHÉ DÉCLENCHÉ : VENTE à " + f_txt(pmL) + ", stop " + f_txt(pmH) + ". Supprime l'achat stop. Clôture 22h00 Paris.", alert.freq_once_per_bar)
if wBuy
    alert("Nasdaq — WILLIAMS DÉCLENCHÉ : ACHAT à " + f_txt(wUp) + ", stop " + f_txt(dayOpen) + ". Supprime la vente stop. Clôture 22h00 Paris.", alert.freq_once_per_bar)
if wSell
    alert("Nasdaq — WILLIAMS DÉCLENCHÉ : VENTE à " + f_txt(wDn) + ", stop " + f_txt(dayOpen) + ". Supprime l'achat stop. Clôture 22h00 Paris.", alert.freq_once_per_bar)
if orbBuy
    alert("Nasdaq — ORB DÉCLENCHÉ : ACHAT à " + f_txt(orbH) + ", stop " + f_txt(orbL) + ". Clôture 22h00 Paris.", alert.freq_once_per_bar)
if orbCancel
    alert("Nasdaq — ORB ANNULÉ : le bas du range a cassé en premier. Supprime l'achat stop.", alert.freq_once_per_bar)

// ---------- rappels
cancelTime = inSess and m < 900 and mEnd >= 900 and ((useORB and orbState == 0 and orbReady) or (useP and pState == 0))
if cancelTime and barstate.isconfirmed
    alert("Nasdaq — 21h00 Paris : supprime les ordres non déclenchés (ORB / pré-marché).", alert.freq_once_per_bar_close)
openPos = pState == 1 or pState == -1 or wDir == 1 or wDir == -1 or orbState == 1
closeSoon = inSess and m < 955 and mEnd >= 955 and openPos
if closeSoon and barstate.isconfirmed
    alert("Nasdaq — Clôture dans 5 min : ferme toutes tes positions à 22h00 Paris (16h00 New York).", alert.freq_once_per_bar_close)

// ---------- affichage
plot(useP and (inSess or inPre) ? pmH : na, "Pré-marché haut", color.new(color.purple, 0), 2, plot.style_linebr)
plot(useP and (inSess or inPre) ? pmL : na, "Pré-marché bas", color.new(color.fuchsia, 0), 2, plot.style_linebr)
plot(useW and inSess ? wUp : na, "Williams achat stop", color.new(color.green, 0), 1, plot.style_linebr)
plot(useW and inSess ? wDn : na, "Williams vente stop", color.new(color.red, 0), 1, plot.style_linebr)
plot(useW and inSess ? dayOpen : na, "Ouverture (stop Williams)", color.new(color.gray, 0), 1, plot.style_linebr)
plot(useORB and inSess and orbReady ? orbH : na, "ORB haut (achat stop)", color.new(color.teal, 0), 2, plot.style_linebr)
plot(useORB and inSess and orbReady ? orbL : na, "ORB bas (stop loss)", color.new(color.orange, 0), 2, plot.style_linebr)
plotshape(pBuy, "Pré-marché achat", shape.triangleup, location.belowbar, color.purple, size = size.small, text = "PM")
plotshape(pSell, "Pré-marché vente", shape.triangledown, location.abovebar, color.purple, size = size.small, text = "PM")
plotshape(wBuy, "Williams achat", shape.triangleup, location.belowbar, color.green, size = size.small, text = "W")
plotshape(wSell, "Williams vente", shape.triangledown, location.abovebar, color.red, size = size.small, text = "W")
plotshape(orbBuy, "ORB achat", shape.triangleup, location.belowbar, color.teal, size = size.small, text = "ORB")
plotshape(orbCancel, "ORB annulé", shape.xcross, location.belowbar, color.orange, size = size.tiny)
